{
  "name": "ember-render-helpers",
  "version": "3.0.3",
  "description": "Helpers that complement @ember/render-modifiers",
  "keywords": [
    "ember-addon",
    "ember-helper",
    "ember-template-helper",
    "template-helper",
    "helper",
    "render",
    "@ember/render-modifiers",
    "did-insert",
    "did-update",
    "will-destroy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/buschtoens/ember-render-helpers.git",
    "directory": "packages/ember-render-helpers"
  },
  "license": "MIT",
  "author": "Jan Buschtöns <jan@buschtoens.me> (https://jan.buschtoens.me)",
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./addon-main.js": "./addon-main.cjs"
  },
  "typesVersions": {
    "*": {
      "*": [
        "declarations/*"
      ]
    }
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist"
  ],
  "scripts": {
    "build": "rollup --config",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "rollup --config",
    "start": "rollup --config --watch",
    "test": "echo 'A v2 addon does not have tests, run tests in test-app'"
  },
  "dependencies": {
    "@embroider/addon-shim": "^1.10.3",
    "decorator-transforms": "^2.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@babel/runtime": "^8.0.7",
    "@embroider/addon-dev": "^8.4.2",
    "@glint/ember-tsc": "^1.13.1",
    "@glint/template": "^1.11.0",
    "@glint/tsserver-plugin": "^2.7.12",
    "@ijlee2-frontend-configs/eslint-config-ember": "^4.8.1",
    "@ijlee2-frontend-configs/prettier": "^3.4.4",
    "@ijlee2-frontend-configs/typescript": "^4.4.1",
    "@rollup/plugin-babel": "^7.1.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^10.0.6",
    "ember-source": "~7.3.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "app-js": {
      "./helpers/did-insert-helper.js": "./dist/_app_/helpers/did-insert-helper.js",
      "./helpers/did-update-helper.js": "./dist/_app_/helpers/did-update-helper.js",
      "./helpers/will-destroy-helper.js": "./dist/_app_/helpers/will-destroy-helper.js"
    },
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  }
}
