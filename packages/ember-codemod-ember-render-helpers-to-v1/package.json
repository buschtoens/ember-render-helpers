{
  "name": "ember-codemod-ember-render-helpers-to-v1",
  "version": "3.1.1",
  "description": "Rename helpers from ember-render-helpers",
  "keywords": [
    "codemod",
    "ember-codemod",
    "emberjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/buschtoens/ember-render-helpers.git",
    "directory": "packages/ember-codemod-ember-render-helpers-to-v1"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": "dist/bin/ember-codemod-ember-render-helpers-to-v1.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./build.sh --production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build",
    "test": "./build.sh --test && mt dist-for-testing --quiet"
  },
  "dependencies": {
    "@codemod-utils/ast-template": "^4.1.1",
    "@codemod-utils/files": "^4.1.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@codemod-utils/tests": "^3.3.0",
    "@ijlee2-frontend-configs/eslint-config-node": "^4.8.0",
    "@ijlee2-frontend-configs/prettier": "^3.4.3",
    "@ijlee2-frontend-configs/typescript": "^4.4.0",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.35",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "22.* || >= 24"
  }
}
