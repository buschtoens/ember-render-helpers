{
  "name": "test-app",
  "version": "2.0.4",
  "private": true,
  "description": "Test app for ember-render-helpers",
  "keywords": [
    "ember-helper",
    "ember-template-helper",
    "template-helper",
    "helper",
    "render",
    "@ember/render-modifiers",
    "did-insert",
    "did-update",
    "will-destroy"
  ],
  "repository": "buschtoens/ember-render-helpers",
  "license": "MIT",
  "author": "Jan Buschtöns <jan@buschtoens.me> (https://jan.buschtoens.me)",
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "build:test": "NODE_ENV=development vite build --config vite.test.config.mts --mode development",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite",
    "test": "pnpm build:test && ember-test --port 0",
    "test:watch": "concurrently \"pnpm build:test --watch\" && \"pnpm ember-test --server\" --names build,test"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@ember/optional-features": "^3.0.0",
    "@ember/test-helpers": "^5.7.0",
    "@embroider/compat": "^4.1.27",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.9",
    "@embroider/router": "^3.0.6",
    "@embroider/vite": "^1.7.15",
    "@glint/ember-tsc": "^1.13.1",
    "@glint/template": "^1.11.0",
    "@glint/tsserver-plugin": "^2.7.12",
    "@ijlee2-frontend-configs/eslint-config-ember": "^4.8.1",
    "@ijlee2-frontend-configs/prettier": "^3.4.4",
    "@ijlee2-frontend-configs/typescript": "^4.4.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.14",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^10.0.6",
    "decorator-transforms": "^2.4.0",
    "ember-cli": "~7.3.0",
    "ember-load-initializers": "^3.0.1",
    "ember-qunit": "^9.2.0",
    "ember-render-helpers": "workspace:*",
    "ember-resolver": "^13.2.0",
    "ember-source": "~7.3.1",
    "ember-testem": "^0.3.3",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": "22.* || >= 24"
  },
  "ember": {
    "edition": "octane"
  }
}
